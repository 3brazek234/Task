# ── Application ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL (read by knexfile.js) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=postgres
# production only
DB_SSL=false

# ── PostgreSQL test DB (read by knexfile.js when NODE_ENV=test) ───
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=appdb_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional – only for an external Redis that requires auth
REDIS_PASSWORD=
# Fail fast: max wait per Redis command before falling back to the DB
REDIS_COMMAND_TIMEOUT_MS=500

# ── Cache ─────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=120
